rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function mine(id) { return signedIn() && request.auth.uid == id; }
    function petOwner(petId) { return get(/databases/$(db)/documents/pets/$(petId)).data.ownerId; }

    match /users/{uid} {
      allow read: if mine(uid) || isAdmin();
      allow create: if mine(uid) && request.resource.data.keys().hasOnly(['name','email','phone','createdAt']);
      allow update: if mine(uid) && request.resource.data.keys().hasOnly(['name','email','phone','createdAt']);
      allow delete: if mine(uid) || isAdmin();
    }
    match /pets/{petId} {
      allow read: if signedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn() && resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }
    // Tags are written only by Cloud Functions (Admin SDK bypasses rules).
    match /tags/{tagId} {
      allow read: if isAdmin() || (signedIn() && resource.data.ownerId == request.auth.uid);
      allow write: if false;
    }
    match /tagSecrets/{id} { allow read, write: if false; }
    match /rateLimits/{id} { allow read, write: if false; }
    match /meta/{id} { allow read, write: if false; }
    match /foundReports/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.ownerId == request.auth.uid);
      allow write: if false;
    }
    match /medicalRecords/{id} {
      allow read, update, delete: if signedIn() && (petOwner(resource.data.petId) == request.auth.uid || isAdmin());
      allow create: if signedIn() && petOwner(request.resource.data.petId) == request.auth.uid;
    }
  }
}
